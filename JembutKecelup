-- ========== FUNGSI TELEPORT ==========
local function teleportTo(pos)
    local char = player.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = CFrame.new(pos)
        Rayfield:Notify({Title = "Teleport", Content = string.format("Moved to (%.0f, %.0f, %.0f)", pos.X, pos.Y, pos.Z)})
    else
        Rayfield:Notify({Title = "Error", Content = "Character not found!"})
    end
end

local teleportLocations = {
    ["🚢 Kapal Luffy"] = Vector3.new(1937, 189, -972),
    ["🏝️ Main Island"] = Vector3.new(1679, 77, -976),
    ["🎣 Shop Rod"] = Vector3.new(1351, 106, -575)
}

-- ========== UI TELEPORT TAB ==========
TeleportTab:CreateSection("📍 Teleport Locations")
for name, pos in pairs(teleportLocations) do
    TeleportTab:CreateButton({
        Name = name,
        Callback = function() teleportTo(pos) end
    })
end

TeleportTab:CreateSection("ℹ️ Info")
