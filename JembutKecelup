    end
})

-- ========== FUNGSI AUTO SELL ==========
local JualIkanRemote = rs:FindFirstChild("JualIkanRemote")

local function sellFish(category)
    if not JualIkanRemote then
        Rayfield:Notify({Title = "Error", Content = "JualIkanRemote not found!"})
        return
    end
    pcall(function()
        JualIkanRemote:FireServer(category)
    end)
    Rayfield:Notify({Title = "Sell Fish", Content = "Sold: " .. category})
end

function _G.sellUnder50()  sellFish("Under50Kg") end
function _G.sellUnder100() sellFish("Under100Kg") end
function _G.sellUnder400() sellFish("Under400Kg") end
function _G.sellUnder600() sellFish("Under600Kg") end
function _G.sellAll()      sellFish("All") end
function _G.sellHand()     sellFish("Hand") end

