local TeleportTab = Window:CreateTab("📍 Teleport")
local SellTab = Window:CreateTab("💰 Sell Fish")

-- ========== VARIABLES FISHING ==========
local isFishing = false
local fishingTask = nil
local selectedRod = "AngelRod"  -- Bisa SeaRod, RobotRod, atau AngelRod
local screenSize = workspace.CurrentCamera.ViewportSize
local tapX = math.clamp(0, 0, screenSize.X)
local tapY = math.clamp(-58, 10, screenSize.Y)

local userSettings = {
    delay = 4,
    cooldown = 1
}

-- ========== CORE FUNCTIONS FISHING ==========
local function tap(x, y)
    VirtualInput:SendMouseButtonEvent(x, y, 0, true, game, 0)
    task.wait(0.05)
    VirtualInput:SendMouseButtonEvent(x, y, 0, false, game, 0)
end

local function getRod()
    if player.Character then
        local rod = player.Character:FindFirstChild(selectedRod)
        if rod then return rod end
    end
    return player.Backpack:FindFirstChild(selectedRod)
end

local function castRod()
    local rod = getRod()
    if not rod then return false end
    local castRemote = rod:FindFirstChild("CastToPosition")
    if castRemote then
        pcall(function() castRemote:FireServer() end)
    else
        tap(tapX, tapY)
    end
    return true
end

local function completeMiniGame()
    local rod = getRod()
    if not rod then return false end
    local mg = rod:FindFirstChild("MiniGame")
    if mg then
        pcall(function() mg:FireServer("Complete") end)
        return true
    end
    return false
end

local function fishingCycle()
    if not isFishing then return end
    castRod()
    local waitTime = userSettings.delay + (math.random(-5, 5) / 10)
    task.wait(waitTime)
    if not isFishing then return end
    completeMiniGame()
    task.wait(userSettings.cooldown)
end

-- ========== FISHING CALLBACKS ==========
function _G.startFishing()
    if isFishing then
        Rayfield:Notify({Title = "Info", Content = "Already running!"})
        return
    end
    local rod = getRod()
    if not rod then
        Rayfield:Notify({Title = "Error", Content = selectedRod .. " not found!"})
        return
    end
    isFishing = true
    fishingTask = task.spawn(function()
        while isFishing do fishingCycle() end
    end)
    Rayfield:Notify({Title = "Auto Fishing", Content = "Started with " .. selectedRod})
end

function _G.stopFishing()
    if not isFishing then
        Rayfield:Notify({Title = "Info", Content = "Not running"})
        return
    end
    isFishing = false
    if fishingTask then task.cancel(fishingTask); fishingTask = nil end
    Rayfield:Notify({Title = "Auto Fishing", Content = "Stopped"})
end

function _G.selectSeaRod()
    selectedRod = "SeaRod"
    Rayfield:Notify({Title = "Rod Changed", Content = "Now using SeaRod"})
end

function _G.selectRobotRod()
    selectedRod = "RobotRod"
    Rayfield:Notify({Title = "Rod Changed", Content = "Now using RobotRod"})
end

function _G.selectAngelRod()
    selectedRod = "AngelRod"
    Rayfield:Notify({Title = "Rod Changed", Content = "Now using AngelRod"})
end

